+// EVLab Step R5: cut / fill of the whole EVLab pad (plot + strips + gate roads + blend skirts) against the natural ground, and the grade of the hill slope behind the plot.
+// npx tsx scripts/evlab-back-hill.ts   (prints numbers, changes nothing)
+import { Config } from '../src/core/Config';
+import { TerrainGenerator } from '../src/terrain/TerrainGenerator';
+import { EVLAB_PLOT } from '../src/evlab/EVLabSite';
+const gen = new TerrainGenerator(Config.world.seed);
+const e = gen.evlab, P = EVLAB_PLOT, sc = { h: 0, water: NaN, fx: 0, fz: 0 };
+const nat = (x: number, z: number): number => { gen.sampleNatural(x, z, sc); return sc.h; };
+const STEP = 6, A = STEP * STEP;
+let cut = 0, fill = 0, cutN = 0, fillN = 0, maxCut = 0, maxFill = 0;
+for (let x = P.x0 - 200; x <= P.x1 + 260; x += STEP) for (let z = P.z0 - 260; z <= P.z1 + 200; z += STEP) {
+  if (!e.near(x, z)) continue;
+  const h0 = nat(x, z), h1 = e.height(x, z, h0, 1), d = h1 - h0;
+  if (d < 0) { cut += -d * A; maxCut = Math.max(maxCut, -d); if (z < P.z0) cutN += -d * A; } else { fill += d * A; maxFill = Math.max(maxFill, d); if (z < P.z0) fillN += d * A; }
+}
+console.log(`pad + skirts: cut ${(cut / 1e6).toFixed(2)} Mm3, fill ${(fill / 1e6).toFixed(2)} Mm3 (max cut ${maxCut.toFixed(1)} m, max fill ${maxFill.toFixed(1)} m); of it north of the fence: cut ${(cutN / 1e6).toFixed(2)}, fill ${(fillN / 1e6).toFixed(2)} Mm3`);
+let worst = 0, top = 0;
+for (const x of [P.x0 + 30, -140, P.x1 - 30]) {
+  let prev = e.height(x, P.z0, nat(x, P.z0), 1), line = '';
+  for (let z = P.z0 - 6; z >= P.z0 - 300; z -= 6) { const h = e.height(x, z, nat(x, z), 1); worst = Math.max(worst, Math.abs(h - prev) / 6); if ((P.z0 - z) % 30 === 0) line += `${(h - e.floorY).toFixed(1)} `; prev = h; }
+  console.log(`profile north of the fence at x=${x} (every 30 m, height above the floor): ${line}`);
+}
+console.log(`steepest grade on those profiles: ${(worst * 100).toFixed(0)} %`);
